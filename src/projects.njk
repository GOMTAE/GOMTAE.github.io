<section class="dark-section section" aria-labelledby="current-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">Recent research</p><h2 id="current-title">A closer look at the work.</h2></div></div><div class="research-grid">{% for p in publications %}{{ researchCard(p, loop.index <= 2) }}{% endfor %}</div></div></section>
