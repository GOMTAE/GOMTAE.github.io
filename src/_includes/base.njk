<!doctype html>
<!-- Generated by Eleventy from src/. Do not edit this file manually. -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}{% if not title %} | Robotic Perception & Aerial Autonomy{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ page.url | absolute }}">
  <link rel="icon" type="image/svg+xml" href="/assets/portfolio/favicon.svg">
  <script>document.documentElement.classList.add('js');</script>
  <link rel="stylesheet" href="/assets/portfolio/site.css">
  <link rel="alternate" type="application/rss+xml" title="Taehyoung Kim - Writing" href="/feed.xml">
  <meta property="og:type" content="{% if article %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ page.url | absolute }}">
  <meta property="og:image" content="{{ (image or site.ogImage) | absolute }}">
  <meta property="og:image:alt" content="{{ imageAlt or 'Taehyoung Kim - robotic perception, 3D scene understanding, aerial autonomy' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ (image or site.ogImage) | absolute }}">
  {% if article %}<meta property="article:published_time" content="{{ page.date | isoDate }}">{% endif %}
  <script type="application/ld+json">{{ personSchema | jsonScript | safe }}</script>
  {% if nav == 'publications' %}<script type="application/ld+json">{{ publicationSchema | jsonScript | safe }}</script>{% endif %}
  {% if article %}<script type="application/ld+json">{{ articleSchema | jsonScript | safe }}</script>{% endif %}
  <script src="/assets/portfolio/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark orbit-brand" href="/" title="Home">{% include 'orbit-logo.njk' %}<span>Taehyoung Kim</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" hidden>Menu <span aria-hidden="true">+</span></button>
      <nav id="primary-nav" aria-label="Main navigation">
        <a href="/"{% if nav == 'home' %} aria-current="page"{% endif %}>Home</a>
        <a href="/projects.html"{% if nav == 'research' %} aria-current="page"{% endif %}>Research</a>
        <a href="/publications.html"{% if nav == 'publications' %} aria-current="page"{% endif %}>Publications</a>
        <a href="/writing.html"{% if nav == 'writing' %} aria-current="page"{% endif %}>Writing</a>
        <a href="/#about">About</a>
      </nav>
      <a class="header-contact" href="mailto:{{ site.email }}">Let’s talk <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="container">
      <div class="footer-top"><a class="wordmark" href="/">Taehyoung Kim<span class="accent">.</span></a><p>Robotic perception. From research to real systems.</p><a href="#main">Back to top <span aria-hidden="true">↑</span></a></div>
      <div class="footer-bottom"><span>© {{ buildYear }} Taehyoung Kim</span><div><a href="{{ site.github }}">GitHub</a><a href="{{ site.linkedin }}">LinkedIn</a><a href="{{ site.scholar }}">Scholar</a><a href="/work.html">Applied work</a><a href="/feed.xml">RSS</a></div></div>
      <p class="attribution">Original site: <a href="https://html5up.net">HTML5 UP</a>. Research figures belong to their credited authors. This is a personal website.</p>
    </div>
  </footer>
</body>
</html>
